{
  "version": 2,
  "builds": [
    {
      "src": "DuramatFront/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/DuramatFront"
      }
    }
  ],
  "rewrites": [
    { "source": "/ping", "destination": "/ping.html" },
    { "source": "/((?!ping|api|.*\\..*).*)", "destination": "/index.html" }
  ]
}