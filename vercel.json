{
  "installCommand": "npm ci --include-workspace-root",
  "buildCommand": "npm run build --workspace=DuramatFront",
  "outputDirectory": "DuramatFront/dist/DuramatFront/browser"
}
{
  "version": 2,
  "installCommand": "cd DuramatFront && npm ci",
  "buildCommand": "cd DuramatFront && npm run build",
  "outputDirectory": "DuramatFront/dist/DuramatFront/browser",
  "rewrites": [
    {
      "source": "/ping",
      "destination": "/ping.html"
    },
    {
      "source": "/((?!ping|api|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}