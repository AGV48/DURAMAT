{
  "version": 2,
  "installCommand": "npm ci --include-workspace-root",
  "buildCommand": "npm --workspace=DuramatFront run build",
  "outputDirectory": "DuramatFront/dist/DuramatFront/browser",
  "rewrites": [
    { "source": "/ping", "destination": "/ping.html" },
    { "source": "/((?!ping|api|.*\\..*).*)", "destination": "/index.html" }
  ]
}